{
  "name": "denantle",
  "private": true,
  "scripts": {
    "build": "node tools/build.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.embedding-worker.json --noEmit && tsc -p tsconfig.finnish-worker.json --noEmit && tsc -p tsconfig.tools.json && tsc -p tests/tsconfig.json",
    "dev": "node tools/develop.mts",
    "pretest": "npm run build",
    "test": "playwright test --config tests/playwright.config.ts",
    "format": "biome format --write .",
    "check": "biome ci ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
